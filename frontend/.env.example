# SmallWebReader Environment Configuration Example
# Copy to .env.local for local development

# Base URL of the backend extraction API (Laptop 2)
# Example: http://192.168.1.50:8080
VITE_API_BASE_URL=http://localhost:8080

# Development Fixture Mode
# Set to 'true' to use bundled mock articles when backend is not connected.
# Set to 'false' (or leave empty) in live/production integration.
VITE_USE_DEV_FIXTURES=true
