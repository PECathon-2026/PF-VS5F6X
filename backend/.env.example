# Environment variables — copy to .env and fill in real values.
# Never commit .env to source control.

# Port the backend listens on (default: 3001)
PORT=3001

# Allowed frontend origin for CORS (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / Supabase Database Connection
# Example: postgresql://postgres:yourpassword@localhost:5432/smallwebreader
# Or Supabase pooled connection string:
DATABASE_URL=postgresql://postgres:placeholder@localhost:5432/smallwebreader

# Connection Pool Settings
DATABASE_MAX_POOL_SIZE=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Path to trusted CA certificate (e.g. Supabase root cert: certs/prod-ca-2021.crt)
DATABASE_SSL_CA_CERT_PATH=certs/prod-ca-2021.crt

# Secret used to HMAC client IP addresses for rate limiting (never store raw IPs)
RATE_LIMIT_HMAC_SECRET=placeholder_secret_change_in_production
